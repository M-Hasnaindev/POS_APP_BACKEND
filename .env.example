##### Shared SQL Server Config #####
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433

##### Tenant 1 #####
DB_1_DATABASE=
DB_1_KEY=
DB_1_LABEL=

##### Tenant 2 #####
DB_2_DATABASE=
DB_2_KEY=
DB_2_LABEL=

##### API / Auth #####
PORT=7500
JWT_SECRET=
JWT_EXPIRES_IN=12h
TENANT_TOKEN_EXPIRES_IN=15m
CRON_SECRET=
# Optional: tenant id containing dbo.AppInfo. Defaults to the first configured tenant.
VERSION_DB_TENANT_ID=tenant_1

##### Android Push - Direct FCM HTTP v1 #####
# Recommended for Vercel: store the complete Firebase service-account JSON as
# one secret environment variable. Do not expose it to the mobile app.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
# FIREBASE_PROJECT_ID=cherryspos-app
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
