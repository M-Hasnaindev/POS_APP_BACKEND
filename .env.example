##### Shared SQL Server Config #####
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433

##### Tenant 1 #####
DB_1_DATABASE=
DB_1_KEY=
DB_1_LABEL=

##### Tenant 2 #####
DB_2_DATABASE=
DB_2_KEY=
DB_2_LABEL=

##### API / Auth #####
PORT=7500
JWT_SECRET=
JWT_EXPIRES_IN=12h
TENANT_TOKEN_EXPIRES_IN=15m
CRON_SECRET=

##### Ollama Cloud / Live AI Reporting #####
# Direct cloud API. No local ollama serve/pull/run is required.
OLLAMA_BASE_URL=https://ollama.com
# IMPORTANT: keep this secret only on the backend / Vercel environment.
OLLAMA_API_KEY=
# Primary model. Backend automatically retries known DeepSeek cloud aliases only if the configured alias is not found.
OLLAMA_MODEL=deepseek-v4-pro
OLLAMA_MODEL_CANDIDATES=deepseek-v4-pro,deepseek-v4-pro:0813,deepseek-v4-pro:cloud,deepseek-v4-pro:0813-cloud
OLLAMA_TIMEOUT_MS=120000
OLLAMA_ANALYSIS_TIMEOUT_MS=48000
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
# Fast by default. DeepSeek analysis uses boolean thinking; configured string levels are normalized safely by the backend.
OLLAMA_THINKING=false
OLLAMA_PLANNER_THINK_LEVEL=medium
OLLAMA_COMPLEX_THINK_LEVEL=high
OLLAMA_MAX_THINKING=false
AI_SQL_TIMEOUT_MS=60000
AI_MAX_ROWS=200
AI_MAX_QUESTION_LENGTH=1200
# Default: verified predefined SQL for fast 460-report execution. Set to
# "ollama" only while developing/testing dynamic SQL planning locally.
AI_REPORT_SQL_MODE=verified
##### Android Push - Direct FCM HTTP v1 #####
# Recommended for Vercel: store the complete Firebase service-account JSON as
# one secret environment variable. Do not expose it to the mobile app.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
# FIREBASE_PROJECT_ID=cherryspos-app
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# AI Reports live SQL planner
# true = include generated read-only SQL in API response for development verification only.
AI_INCLUDE_SQL_DEBUG=false
# Recommended for direct live AI reports (planner + MSSQL execution + narrative).
