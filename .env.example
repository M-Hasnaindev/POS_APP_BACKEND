##### Shared SQL Server Config #####
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433

##### Tenant 1 #####
DB_1_DATABASE=
DB_1_KEY=
DB_1_LABEL=

##### Tenant 2 #####
DB_2_DATABASE=
DB_2_KEY=
DB_2_LABEL=

##### API / Auth #####
PORT=7500
JWT_SECRET=
JWT_EXPIRES_IN=12h
TENANT_TOKEN_EXPIRES_IN=15m
CRON_SECRET=

##### Ollama / Live AI Reporting #####
# On a local backend this can remain 127.0.0.1. On Vercel, use a securely
# reachable Ollama host; 127.0.0.1 there is the Vercel function itself.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
AI_SQL_TIMEOUT_MS=60000
AI_MAX_ROWS=200
AI_MAX_QUESTION_LENGTH=1200
##### Android Push - Direct FCM HTTP v1 #####
# Recommended for Vercel: store the complete Firebase service-account JSON as
# one secret environment variable. Do not expose it to the mobile app.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
# FIREBASE_PROJECT_ID=cherryspos-app
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# AI Reports live SQL planner
# true = include generated read-only SQL in API response for development verification only.
AI_INCLUDE_SQL_DEBUG=false
# Recommended for direct live AI reports (planner + MSSQL execution + narrative).
